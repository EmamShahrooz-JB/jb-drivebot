# ==========================================================================
# JB-DriveBot — نمونه متغیرهای محیطی
# هیچ مقدار محرمانه‌ای در این فایل نیست. آن را به .env کپی و پر کنید.
#   cp .env.example .env && chmod 600 .env
# ==========================================================================

# ---------- عمومی ----------
NODE_ENV=production
LOG_LEVEL=info

# ---------- تلگرام ----------
# از @BotFather بگیرید
TELEGRAM_BOT_TOKEN=
# آیدی عددی خودتان را با /id یا @userinfobot بگیرید. فقط این افراد دسترسی دارند.
# اولین آیدی، مالک ربات است (پیام‌های اتصال برای او ارسال می‌شود).
ADMIN_USER_IDS=

# polling برای Altare App Hosting ساده‌ترین و پایدارترین گزینه است.
TELEGRAM_TRANSPORT=polling
TELEGRAM_API_ROOT=https://api.telegram.org
# اگر Local Bot API Server دارید، مقدار بالا را به آدرس آن تغییر دهید
# (مثلاً http://127.0.0.1:8081) تا سقف دریافت از ۲۰MB به ۲GB برسد.
# TELEGRAM_API_ROOT=http://127.0.0.1:8081

# فقط برای حالت webhook:
# WEBHOOK_PUBLIC_URL=https://your-app.altare.app
# WEBHOOK_SECRET=

# ---------- HTTP / جفت‌سازی ----------
# Altare پورت را از متغیر PORT تزریق می‌کند؛ همین را نگه دارید.
PORT=8080
HOST=0.0.0.0
# آدرس عمومی HTTPS همین سرویس روی Altare (برای ابزار محلی اتصال لازم است)
PUBLIC_BASE_URL=https://your-app.altare.app
ENABLE_PAIRING_SERVER=true
PAIRING_TTL_SECONDS=600
PAIRING_MAX_ATTEMPTS=5

# ---------- Google OAuth ----------
# Client ID و Client Secret از نوع Desktop app
# اگر خالی باشند ربات بالا می‌آید ولی قابلیت‌های Drive غیرفعال می‌مانند (پیام روشن می‌دهد)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# file (کمترین دسترسی) | readonly | full  — توضیح در docs/SCOPES.md
GOOGLE_SCOPES_MODE=file
# پورت سرور محلی Callback روی کامپیوتر شما (باید در ابزار محلی هم همین باشد)
OAUTH_REDIRECT_PORT=8765
# اگر می‌خواهید فقط یک حساب مشخص مجاز باشد:
# GOOGLE_EXPECTED_EMAIL=you@gmail.com

# ---------- رمزنگاری ----------
# کلید اصلی رمزنگاری توکن‌ها. با دستور زیر بسازید:
#   openssl rand -base64 32
# این مقدار را گم نکنید؛ بدون آن توکن‌های ذخیره‌شده قابل بازگشایی نیستند.
APP_ENCRYPTION_KEY=

# ---------- دیتابیس ----------
# sqlite برای شروع ساده؛ postgres برای پایداری بیشتر روی Altare
DB_DRIVER=sqlite
SQLITE_PATH=./data/jb-drivebot.sqlite
# DB_DRIVER=postgres
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require
DB_POOL_MAX=5

# ---------- مسیرها ----------
DATA_DIR=./data
# TMP_DIR=./data/tmp
# BACKUP_DIR=./data/backups
TEMP_QUOTA_BYTES=6442450944

# ---------- محدودیت‌ها ----------
# سقف دریافت فایل از تلگرام (Bot API ابری: ۲۰MB — با Local Bot API تا ۲۰۰۰MB)
MAX_TELEGRAM_DOWNLOAD_BYTES=20971520
# سقف ارسال فایل به تلگرام (Bot API ابری: ۵۰MB)
MAX_TELEGRAM_SEND_BYTES=52428800
# سقف دانلود از لینک
MAX_LINK_DOWNLOAD_BYTES=4294967296
MAX_REDIRECTS=5
LINK_TIMEOUT_MS=120000

# ---------- صف ----------
UPLOAD_CONCURRENCY=2
DOWNLOAD_CONCURRENCY=2
OTHER_CONCURRENCY=1
JOB_MAX_ATTEMPTS=4
JOB_POLL_INTERVAL_MS=1000
JOB_TIMEOUT_MS=3600000

# ---------- Drive ----------
DEFAULT_DRIVE_FOLDER_NAME=JB-DriveBot
DRIVE_UPLOAD_CHUNK_BYTES=8388608

# ---------- امنیت ----------
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
CALLBACK_TTL_SECONDS=900

# ---------- ابزارهای اختیاری ----------
ENABLE_YTDLP=false
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
